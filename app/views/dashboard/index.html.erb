<div class="min-h-screen bg-amber-50 flex flex-col items-center justify-center px-4">

  <%# ログアウトリンク %>
  <div class="absolute top-4 right-4">
    <%= link_to "ログアウト", destroy_user_session_path,
        data: { turbo_method: :delete },
        class: "text-sm text-amber-600 hover:underline" %>
  </div>

  <div class="text-center mb-10">
    <h1 class="text-2xl font-bold text-amber-800 mb-2">
      こんにちは、<%= current_user.email %>さん！
    </h1>
    <p class="text-amber-700">今日はどれにしますか？</p>
  </div>

  <div class="flex flex-col gap-4 w-full max-w-xs">
    <button class="bg-amber-300 text-white font-bold py-3 px-6 rounded-full shadow">
      かんたん
    </button>
    <button class="bg-amber-400 text-white font-bold py-3 px-6 rounded-full shadow">
      ふつう
    </button>
    <button class="bg-amber-500 text-white font-bold py-3 px-6 rounded-full shadow">
      むずかしい
    </button>
  </div>

</div>