<h1 class="text-2xl font-bold text-center mt-8 mb-6">今日の難易度を選ぼう</h1>

<div class="flex flex-col items-center gap-4 max-w-sm mx-auto">
  <%= link_to "やさしい（easy）", question_path(difficulty: "easy"), class: "w-full text-center py-3 rounded-lg bg-green-400 text-white font-bold" %>
  <%= link_to "ふつう（normal）", question_path(difficulty: "normal"), class: "w-full text-center py-3 rounded-lg bg-yellow-400 text-white font-bold" %>
  <%= link_to "むずかしい（hard）", question_path(difficulty: "hard"), class: "w-full text-center py-3 rounded-lg bg-red-400 text-white font-bold" %>
</div>
