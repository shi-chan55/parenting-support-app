<div class="w-full min-h-screen bg-amber-50 flex flex-col items-center justify-center px-4 pb-32">
  <h1 class="text-xl sm:text-2xl font-bold text-center mb-16">
    今日の難易度を<br class="sm:hidden">選ぼう
  </h1>

  <div class="flex flex-col items-center gap-4 w-full max-w-sm">
    <%= link_to "かんたん", question_path(difficulty: "easy"), class: "w-full text-center py-3 rounded-full shadow bg-emerald-400 hover:bg-emerald-500 text-white font-bold" %>
    <%= link_to "ふつう", question_path(difficulty: "normal"), class: "w-full text-center py-3 rounded-full shadow bg-amber-400 hover:bg-amber-500 text-white font-bold" %>
    <%= link_to "むずかしい", question_path(difficulty: "hard"), class: "w-full text-center py-3 rounded-full shadow bg-rose-400 hover:bg-rose-500 text-white font-bold" %>
  </div>
</div>
