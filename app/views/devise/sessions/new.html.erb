<div class="w-full min-h-screen bg-amber-50 flex flex-col items-center justify-center pb-32 px-4">
  <div class="w-full max-w-xs">
    <h2 class="text-2xl font-bold text-amber-800 mb-6 text-center">ログイン</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-4">
        <%= f.label :email, "メールアドレス", class: "block text-sm text-amber-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full border border-amber-300 rounded-lg px-3 py-2" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, "パスワード", class: "block text-sm text-amber-700 mb-1" %>
        <%= f.password_field :password, autocomplete: "current-password",
              class: "w-full border border-amber-300 rounded-lg px-3 py-2" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-6 flex items-center gap-2">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, "ログイン状態を保持する", class: "text-sm text-amber-700" %>
        </div>
      <% end %>

      <%= f.submit "ログイン",
            class: "w-full bg-amber-400 hover:bg-amber-500 text-white font-bold py-3 rounded-full shadow" %>
    <% end %>

    <div class="text-center mt-4 text-sm">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>