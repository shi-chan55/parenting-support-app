<div class="max-w-md mx-auto mt-8 text-center">
  <h1 class="text-2xl font-bold mb-6">マイページ</h1>

  <div class="bg-gray-50 rounded-lg p-4 mb-6 text-left">
    <p class="text-sm text-gray-600">メールアドレス</p>
    <p class="font-bold"><%= @user.email %></p>
  </div>

  <div class="flex flex-col gap-3">
    <%= link_to "記録一覧を見る", records_path, class: "w-full py-3 rounded-lg bg-blue-400 text-white font-bold" %>
    <%= link_to "難易度選択に戻る", difficulties_path, class: "w-full py-3 rounded-lg bg-gray-300 text-gray-700 font-bold" %>
    <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "w-full py-3 rounded-lg bg-red-400 text-white font-bold" %>
  </div>
</div>
