<div class="max-w-md mx-auto mt-8 text-center">
  <h1 class="text-2xl font-bold mb-6">マイページ</h1>

  <div class="bg-amber-50 rounded-lg p-4 mb-6 text-left">
    <p class="text-sm text-gray-600">メールアドレス</p>
    <p class="font-bold"><%= @user.email %></p>
  </div>

  <div class="flex flex-col gap-3">
    <%= link_to "記録一覧を見る", records_path, class: "w-full py-3 rounded-full bg-amber-400 text-white font-bold" %>
    <%= link_to "難易度選択に戻る", difficulties_path, class: "w-full py-3 rounded-full bg-amber-100 border-2 border-amber-400 text-amber-800 font-bold" %>
  </div>
</div>
