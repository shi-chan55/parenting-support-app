<div class="w-full min-h-screen bg-amber-50 flex flex-col items-center justify-center px-4 py-4 text-center">
  <div class="w-full max-w-2xl">
    <% if @question %>
      <% if @question.images.attached? %>
        <%= image_tag @question.images.sample, class: "w-full aspect-square object-cover rounded-2xl shadow-lg mb-4" %>
      <% end %>

      <h1 class="text-xl font-bold mb-1"><%= @question.title %></h1>
      <p class="text-base text-gray-700 mb-4"><%= @question.body %></p>

      <div data-controller="hint-guide"
           data-hint-guide-hint-value="<%= @question.hint %>"
           data-hint-guide-guide-value="<%= @question.parent_guide %>"
           class="mb-4">
        <div class="flex gap-3 mb-2">
          <button data-action="click->hint-guide#showHint" class="flex-1 py-2 rounded-lg bg-blue-100 text-blue-700 font-bold text-sm">
            ヒント
          </button>
          <button data-action="click->hint-guide#showGuide" class="flex-1 py-2 rounded-lg bg-orange-100 text-orange-700 font-bold text-sm">
            声かけ例
          </button>
        </div>
        <p data-hint-guide-target="content" class="hidden text-left bg-white shadow p-3 rounded-lg text-sm"></p>
      </div>

      <%= render "complete_button", question: @question, difficulty: @difficulty, error: nil %>
    <% else %>
      <p>この難易度の問題がまだ登録されていません。</p>
    <% end %>
  </div>
</div>