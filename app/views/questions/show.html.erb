<div class="max-w-md mx-auto mt-8 text-center">
  <% if @question %>
    <% if @question.images.attached? %>
      <%= image_tag @question.images.sample, class: "w-full rounded-lg mb-4" %>
    <% end %>

    <h1 class="text-2xl font-bold mb-2"><%= @question.title %></h1>
    <p class="text-lg mb-6"><%= @question.body %></p>

    <div class="flex flex-col gap-4">
      <div data-controller="toggle">
        <button data-action="click->toggle#toggle" class="w-full py-2 rounded-lg bg-blue-100 text-blue-700 font-bold">
          ヒントを見る
        </button>
        <p data-toggle-target="content" class="hidden mt-2 text-left bg-blue-50 p-3 rounded-lg">
          <%= @question.hint %>
        </p>
      </div>

      <div data-controller="toggle">
        <button data-action="click->toggle#toggle" class="w-full py-2 rounded-lg bg-orange-100 text-orange-700 font-bold">
          声かけ例を見る
        </button>
        <p data-toggle-target="content" class="hidden mt-2 text-left bg-orange-50 p-3 rounded-lg">
          <%= @question.parent_guide %>
        </p>
      </div>
    </div>
    <div class="mt-6">
      <%= render "complete_button", question: @question, difficulty: @difficulty, error: nil %>
    </div>
  <% else %>
    <p>この難易度の問題がまだ登録されていません。</p>
  <% end %>
</div>